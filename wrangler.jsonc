{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsmod-org",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // `npx wrangler deploy` (and `wrangler dev`) build the site first.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
  // Optional: `npx wrangler secret put STEAM_API_KEY` enables live server info.
}
